{
  "name": "cycling-manager",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/validate-race-registration-routes.mjs",
    "marketing:assets": "node scripts/generate-season2-marketing-assets.mjs && node scripts/generate-evergreen-sharing-assets.mjs",
    "marketing:sharing": "node scripts/generate-evergreen-sharing-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "i18n:check": "node scripts/build-i18n-catalog.mjs --check",
    "names:validate": "node scripts/validate-rider-names.mjs",
    "equipment:assets": "node scripts/optimize-equipment-assets.mjs",
    "sponsors:validate": "tsx scripts/validate-sponsors.ts",
    "sponsors:validate:strict": "tsx scripts/validate-sponsors.ts --strict-assets",
    "sponsors:sync": "tsx scripts/sync-sponsors.ts",
    "race:calibrate": "tsx scripts/calibrate-race-simulation.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "@vercel/speed-insights": "^2.0.0",
    "flag-icons": "^7.5.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
